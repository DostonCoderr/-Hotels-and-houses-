### ============================================
### 1. AUTH
### ============================================

### 1.1 Register (yangi user)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@etagi.ru",
  "password": "test1234",
  "phone": "+998901234567"
}

### 1.2 Login (demo user)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "demo@etagi.ru",
  "password": "demo1234"
}

### 1.3 Admin Login
POST {{baseUrl}}/auth/admin/login
Content-Type: application/json

{
  "email": "admin@etagi.ru",
  "password": "admin123"
}

### 1.4 Me (user token bilan)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{userToken}}

### 1.5 Admin Me
GET {{baseUrl}}/auth/admin/me
Authorization: Bearer {{adminToken}}

### 1.6 Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{userToken}}

### ============================================
### 2. PROPERTIES
### ============================================

### 2.1 Barcha properties
GET {{baseUrl}}/properties?page=1&limit=10

### 2.2 Bitta property (ID=1)
GET {{baseUrl}}/properties/1

### 2.3 Property yaratish (admin) — TO'G'RI
POST {{baseUrl}}/properties/admin
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Yangi kvartira test",
  "slug": "yangi-kvartira-test-1",
  "typeId": 1,
  "complexId": 1,
  "apartmentNo": "777",
  "rooms": 3,
  "area": 75.5,
  "floor": 5,
  "floorsTotal": 9,
  "price": 55000,
  "priceM2": 728,
  "status": "available",
  "description": "Zo'r kvartira, test uchun",
  "address": "Toshkent, Chilonzor",
  "lat": 41.276418,
  "lng": 69.203505,
  "features": ["Balkon", "Lift"],
  "advantages": ["Yangi bino"],
  "published": true
}

### 2.4 Property update (ID=1)
PUT {{baseUrl}}/properties/admin/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "price": 60000
}

### 2.5 Property duplicate (ID=1)
POST {{baseUrl}}/properties/admin/1/duplicate
Authorization: Bearer {{adminToken}}

### 2.6 Property delete — ehtiyot bo'ling (ID=7 yangi yaratilgan)
DELETE {{baseUrl}}/properties/admin/10
Authorization: Bearer {{adminToken}}

